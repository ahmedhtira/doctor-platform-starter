# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never commit real credentials.

# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses Row Level Security. Never expose to the browser,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (https://resend.com) — used for transactional email in a later
# milestone. Not required yet for M0.
RESEND_API_KEY=your-resend-api-key
