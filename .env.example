# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never commit real credentials.

# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses Row Level Security. Never expose to the browser,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (https://resend.com) — transactional email delivery (M7).
RESEND_API_KEY=your-resend-api-key

# "Display name <local-part@domain>" the worker sends from. The default
# below is Resend's own sandbox sender — works for local/dev without
# verifying a custom domain.
EMAIL_FROM_ADDRESS="Doctor Platform <onboarding@resend.dev>"

# Base origin used to build management links from the email worker (which
# has no window.location) — e.g. http://localhost:3000 locally.
APP_URL=http://localhost:3000

# High-entropy secret used to *deterministically derive* (HMAC-SHA256) the
# raw management token embedded in confirmation/reschedule emails — see
# src/lib/email/derive-management-token.ts. Generate with:
#   openssl rand -hex 32
#
# STABILITY WARNING: this key must stay the same for as long as any
# email_outbox row that could still be retried exists. Rotating it changes
# the derived token for every not-yet-sent row, silently invalidating
# management links that may already be in a patient's or staff member's
# hands. There is no rotation mechanism in M7 — a future milestone would
# need to version this key (mirroring email_outbox.template_version)
# before rotation could be done safely. Never commit the real value.
EMAIL_TOKEN_DERIVATION_KEY=your-64-character-hex-secret
