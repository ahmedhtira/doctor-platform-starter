# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never commit real credentials.

# Supabase project (Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses Row Level Security. Never expose to the browser,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# Resend transactional email delivery
RESEND_API_KEY=your-resend-api-key

# Appointment confirmations, cancellations, reschedules, reminders
EMAIL_APPOINTMENTS_FROM_ADDRESS="Dewini Appointments <appointments@send.dewini.net>"

# Doctor/staff/platform notifications
EMAIL_NOTIFICATIONS_FROM_ADDRESS="Dewini Notifications <notifications@send.dewini.net>"

# Password reset / account-related no-reply email
EMAIL_NOREPLY_FROM_ADDRESS="Dewini <no-reply@send.dewini.net>"

# Production base URL used when generating links inside emails
APP_URL=https://dewini.net

# High-entropy secret used to *deterministically derive* (HMAC-SHA256) the
# raw management token embedded in confirmation/reschedule emails — see
# src/lib/email/derive-management-token.ts. Generate with:
#   openssl rand -hex 32
#
# STABILITY WARNING: this key must stay the same for as long as any
# email_outbox row that could still be retried exists. Rotating it changes
# the derived token for every not-yet-sent row, silently invalidating
# management links that may already be in a patient's or staff member's
# hands. There is no rotation mechanism in M7 — a future milestone would
# need to version this key (mirroring email_outbox.template_version)
# before rotation could be done safely. Never commit the real value.
EMAIL_TOKEN_DERIVATION_KEY=your-64-character-hex-secret

# M9. Only needed in production, and only if the email worker is
# triggered via the Vercel Cron Route Handler
# (src/app/api/cron/process-email-outbox/route.ts) rather than run
# manually. Vercel automatically sends this back as an `Authorization:
# Bearer <value>` header on every cron invocation, which the handler
# checks — see DEPLOYMENT.md. A random string, 16+ characters
# recommended (Vercel's own suggestion). Generate with:
#   openssl rand -hex 32
CRON_SECRET=your-random-cron-secret

# M10. The sole platform admin's Supabase Auth user id (a UUID from
# auth.users.id) — NOT an email address. This is the only account
# authorized to open /admin and provision/edit/suspend/delete doctors
# (src/lib/admin/is-platform-admin.ts). Email is not used for this check
# because it isn't a stable identifier; the admin's own account must
# already exist in auth.users before this can be set — see DEPLOYMENT.md
# for how to bootstrap it and find its id.
PLATFORM_ADMIN_USER_ID=00000000-0000-0000-0000-000000000000
